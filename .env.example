# Nonsecret options only. Copy to .env; never put passwords or AES keys here.
WATERMETER_IMAGE=watermeter:local
METER_ID=12345678
METER_DRIVER=dme173
METER_NAME=Water
WMBUS_FREQUENCY=868.95M
WMBUS_MODE=c1
# reference (pinned upstream) or dev (fork snapshot bundled in this image).
WMBUS_DECODER=reference
# Runtime demodulator tuning; restart after changes. Defaults favor reception.
WMBUS_FAST_MATH=false
WMBUS_ALGORITHM=both
# Diagnostics: debug, info, warning, error, critical. MQTT readings log only at debug.
LOG_LEVEL=info
# Compose maps ./secrets/meter_aes_key to /run/secrets/meter_aes_key.
# Auth override maps ./secrets/mqtt_password to /run/secrets/mqtt_password.
MQTT_HOST=broker.example.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=watermeter
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
HA_STATUS_TOPIC=homeassistant/status
